{{ ansible_managed | comment }}
# Rendered from roles/chrony/templates/chrony.conf.j2 for {{ inventory_hostname }}.
# Local edits are overwritten on the next run — change the role's defaults.

{% for server in chrony_ntp_servers %}
server {{ server }}{% if chrony_use_iburst %} iburst{% endif %}

{% endfor %}

# Record the rate at which this clock gains or loses time, so chrony can
# compensate immediately at the next start rather than relearning it.
driftfile {{ chrony_driftfile }}

# Step rather than slew when the offset is large, but only for the first few
# updates after start. Slewing a multi-second offset takes hours.
makestep {{ chrony_makestep_threshold }} {{ chrony_makestep_limit }}

# Let chrony discipline the RTC so the clock is close on next boot.
rtcsync

{% if chrony_is_server and chrony_allow_networks | length > 0 %}
# Serving time to other hosts.
{% for network in chrony_allow_networks %}
allow {{ network }}
{% endfor %}
{% else %}
# Client only: this host serves time to nobody. Set chrony_is_server and
# chrony_allow_networks to change that.
{% endif %}

logdir /var/log/chrony
